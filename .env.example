# Copy to .env for local development. Never commit real values.
JA_PUBLIC_BASE_PATH=/j-aautomation
JA_PORTAL_BASE_PATH=/j-aautomation/app
JA_DATABASE_PATH=./data/app.db
JA_MIGRATIONS_PATH=./migrations
JA_DOCUMENT_ROOT=./data/documents
JA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
JA_PUBLIC_SITE_ORIGIN=http://localhost:5173
# Required at runtime; generate a unique random value for every deployment.
JA_AUTH_SECRET=replace-with-at-least-32-random-characters
# Required for private offline-cache partitioning; these are deployment identifiers, not defaults.
JA_TENANT_ID=replace-with-tenant-identifier
JA_DEPLOYMENT_ID=replace-with-deployment-identifier
JA_WEBAUTHN_RP_ID=localhost
JA_WEBAUTHN_ORIGIN=http://localhost:5174
JA_OFFLINE_ENABLED=false
# Local development keeps mail integration disabled unless it is deliberately
# pointed at an isolated Stalwart instance with a test-only token.
JA_MAIL_AUTH_ENABLED=false
JA_IMAP_HOST=127.0.0.1
JA_IMAP_PORT=993
JA_IMAP_SERVERNAME=localhost
JA_IMAP_TIMEOUT_MS=4000
JA_IMAP_TLS_REJECT_UNAUTHORIZED=true
JA_STALWART_JMAP_URL=http://127.0.0.1:8080/jmap
JA_STALWART_DOMAIN=j-aautomation.com
JA_STALWART_EXCLUDED_USERNAMES=jaautomation-provisioner
JA_STALWART_TOKEN_FILE=/run/secrets/stalwart-mail-provisioner.token
JA_BACKUP_ROOT=./data/backups
JA_BACKUP_RETENTION_DAYS=30
JA_MIN_FREE_BYTES=1073741824
# Always-on jobs worker poll interval for local --loop / preview:release.
JA_JOBS_POLL_MS=5000
JA_SMTP_URL=
JA_FORM_RECIPIENT=
JA_MALWARE_SCANNER_URL=
