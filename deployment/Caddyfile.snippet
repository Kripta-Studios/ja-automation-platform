redir /j-aautomation /j-aautomation/en/ 308
handle_path /j-aautomation/portal-assets/* {
  rewrite * /j-aautomation{path}
  reverse_proxy 127.0.0.1:5100
}
handle /j-aautomation/_app/* {
  reverse_proxy 127.0.0.1:5100
}
handle /j-aautomation/app* {
  reverse_proxy 127.0.0.1:5100
}
handle /j-aautomation/api/public/* {
  reverse_proxy 127.0.0.1:5100
}
@jaautomation_health_local {
  path /j-aautomation/health/*
  remote_ip 127.0.0.1 ::1
}
handle @jaautomation_health_local {
  reverse_proxy 127.0.0.1:5100
}
handle /j-aautomation/health/* {
  respond "Not Found" 404
}
handle /j-aautomation/* {
  reverse_proxy 127.0.0.1:5101
}
