FROM node:24.19.0-bookworm-slim AS build
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps/portal ./apps/portal
COPY packages ./packages
COPY migrations ./migrations
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ja/portal build

FROM node:24.19.0-bookworm-slim
ENV NODE_ENV=production PORT=5100 HOST=127.0.0.1
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates && rm -rf /var/lib/apt/lists/* && useradd --system --uid 10001 --create-home jaautomation
WORKDIR /app
COPY --from=build --chown=jaautomation:jaautomation /workspace/apps/portal/build ./build
COPY --from=build --chown=jaautomation:jaautomation /workspace/apps/portal/package.json ./package.json
COPY --from=build --chown=jaautomation:jaautomation /workspace/migrations ./migrations
USER jaautomation
EXPOSE 5100
CMD ["node","build"]
