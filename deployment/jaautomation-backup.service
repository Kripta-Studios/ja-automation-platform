[Unit]
Description=Backup J&A Automation SQLite/private documents and replicate encrypted continuity copy
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/opt/jaautomation/current
EnvironmentFile=-/etc/jaautomation/jaautomation.env
ExecStart=/opt/jaautomation/runtime/node/bin/node deployment/scripts/continuity-backup.mjs
TimeoutStartSec=300
