[Unit]
Description=J&A Automation durable jobs
After=docker.service jaautomation.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/jaautomation/current
EnvironmentFile=/etc/jaautomation/jaautomation.env
UMask=0027
PrivateTmp=true
NoNewPrivileges=true
ExecStartPre=/usr/bin/test -r /etc/jaautomation/jaautomation.env
ExecStartPre=/usr/bin/test -r /opt/jaautomation/current/deployment/compose.production.yml
ExecStartPre=/usr/bin/docker compose --env-file /etc/jaautomation/jaautomation.env -f deployment/compose.production.yml config --quiet
ExecStart=/usr/bin/docker compose --env-file /etc/jaautomation/jaautomation.env -f deployment/compose.production.yml up -d --no-deps jobs
ExecStop=/usr/bin/docker compose --env-file /etc/jaautomation/jaautomation.env -f deployment/compose.production.yml stop jobs
TimeoutStartSec=120
