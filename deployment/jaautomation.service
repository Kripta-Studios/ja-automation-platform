[Unit]
Description=J&A Automation portal
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/jaautomation/current
EnvironmentFile=/etc/jaautomation/jaautomation.env
ExecStartPre=/usr/bin/docker compose --project-name deployment --env-file /etc/jaautomation/jaautomation.env -f deployment/compose.production.yml config --quiet
ExecStart=/usr/bin/docker compose --project-name deployment --env-file /etc/jaautomation/jaautomation.env -f deployment/compose.production.yml up -d --no-build --pull never
ExecStop=/usr/bin/docker compose --project-name deployment --env-file /etc/jaautomation/jaautomation.env -f deployment/compose.production.yml stop
TimeoutStartSec=180
[Install]
WantedBy=multi-user.target
