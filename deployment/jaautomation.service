[Unit]
Description=J&A Automation portal
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/j-aautomation/current
ExecStart=/usr/bin/docker compose -f deployment/compose.production.yml up -d
ExecStop=/usr/bin/docker compose -f deployment/compose.production.yml down
TimeoutStartSec=180
[Install]
WantedBy=multi-user.target
