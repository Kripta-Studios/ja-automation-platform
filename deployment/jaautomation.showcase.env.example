# Showcase-only environment. Demo buttons intentionally grant role-scoped access without a
# password. Do not use this file for a production/customer deployment.
JA_RELEASE_TAG=showcase-20260819
JA_AUTH_SECRET=REPLACE_ON_VPS_WITH_OPENSSL_RAND_HEX_32
JA_DEMO_MODE=true
JA_ALLOWED_ORIGINS=https://gex-dashboard.hopto.org
JA_PUBLIC_SITE_ORIGIN=https://gex-dashboard.hopto.org
JA_WEBAUTHN_RP_ID=gex-dashboard.hopto.org
JA_WEBAUTHN_ORIGIN=https://gex-dashboard.hopto.org
JA_SMTP_URL=
JA_FORM_RECIPIENT=
JA_MALWARE_SCANNER_URL=
JA_MALWARE_SCANNER_REQUIRED=false
JA_MALWARE_SCANNER_RESULT=
JA_MALWARE_SCANNER_PROVIDER=
JA_OUTBOX_WEBHOOK_URL=
JA_OUTBOX_WEBHOOK_SECRET=
# Set to the demoUserIds.admin value printed by the seed before enabling jobs.
JA_JOB_ACTOR_ID=
JA_BACKUP_ROOT=/var/backups/jaautomation
JA_BACKUP_RETENTION_DAYS=30
