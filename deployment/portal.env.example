JA_RELEASE_TAG=latest
JA_AUTH_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
# Deployment partition identifiers; set unique values per tenant/deployment.
JA_TENANT_ID=CHANGE_ME_WITH_DEPLOYMENT_TENANT_ID
JA_DEPLOYMENT_ID=CHANGE_ME_WITH_DEPLOYMENT_ID
JA_ALLOWED_ORIGINS=https://j-aautomation.com
JA_PUBLIC_SITE_ORIGIN=https://j-aautomation.com
JA_WEBAUTHN_RP_ID=j-aautomation.com
JA_WEBAUTHN_ORIGIN=https://j-aautomation.com
JA_OFFLINE_ENABLED=false
# Live Stalwart integration. The token is mounted as a Docker secret; never
# put the API key, an admin password or a hash in this environment file.
JA_MAIL_AUTH_ENABLED=true
JA_IMAP_HOST=mx1.j-aautomation.com
JA_IMAP_PORT=993
JA_IMAP_SERVERNAME=mx1.j-aautomation.com
JA_IMAP_TIMEOUT_MS=4000
JA_IMAP_TLS_REJECT_UNAUTHORIZED=true
JA_STALWART_JMAP_URL=https://mx1.j-aautomation.com/jmap
JA_STALWART_DOMAIN=j-aautomation.com
JA_STALWART_TOKEN_FILE=/run/secrets/stalwart-mail-provisioner.token
JA_SMTP_URL=
JA_SMTP_USERNAME=no-reply@j-aautomation.com
JA_SMTP_FROM=no-reply@j-aautomation.com
JA_FORM_RECIPIENT=
# Go-live scanner is intentionally disabled. Keep result/provider empty so
# stored document state remains `not_scanned`, never a fabricated `clean`.
JA_MALWARE_SCANNER_URL=
JA_MALWARE_SCANNER_REQUIRED=false
JA_MALWARE_SCANNER_RESULT=
JA_MALWARE_SCANNER_PROVIDER=
JA_OUTBOX_WEBHOOK_URL=
JA_OUTBOX_WEBHOOK_SECRET=
JA_OUTBOX_CUTOVER_AT=
JA_BACKUP_ROOT=/var/backups/jaautomation
JA_BACKUP_RETENTION_DAYS=30
# Readiness fails closed below this free-space threshold. Use a non-negative
# integer number of bytes; 1 GiB is the production-safe default.
JA_MIN_FREE_BYTES=1073741824
